{
  "name": "stm-term",
  "version": "1.0.0",
  "description": "Terminal with short-term (5 tabs) and long-term (searchable, Haiku-tagged) memory",
  "main": "electron/main.js",
  "scripts": {
    "daemon": "node --disable-warning=ExperimentalWarning src/server.js",
    "app": "electron .",
    "qa": "node test/qa.mjs",
    "stop": "curl -s -XPOST -H x-stm:1 http://127.0.0.1:${STM_PORT:-4790}/api/shutdown",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "playwright": "^1.64.1"
  }
}
